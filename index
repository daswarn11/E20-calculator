<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Hidden E20 Fuel Tax Calculator</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 sm:p-6">

  <div class="max-w-xl w-full bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8">
    
    <div class="mb-6 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs px-3 py-1 rounded-full font-semibold mb-2">
        Independent Policy Impact Tool
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        The Hidden E20 Tax Calculator
      </h1>
      <p class="text-slate-400 text-sm mt-1">
        Calculate your real financial loss from ethanol-blended petrol efficiency drop.
      </p>
    </div>

    <div class="mb-6">
      <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">
        Quick Presets:
      </label>
      <div class="grid grid-cols-3 gap-2">
        <button onclick="setPreset(120, 100, 45, 6)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 py-2 px-3 rounded-lg border border-slate-700 transition">
          🛵 Gig Rider
        </button>
        <button onclick="setPreset(35, 100, 15, 6)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 py-2 px-3 rounded-lg border border-slate-700 transition">
          🚗 Commuter
        </button>
        <button onclick="setPreset(200, 100, 16, 6)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 py-2 px-3 rounded-lg border border-slate-700 transition">
          🚕 Cab Driver
        </button>
      </div>
    </div>

    <div class="space-y-5">
      
      <div>
        <div class="flex justify-between text-sm mb-1">
          <span class="text-slate-300 font-medium">Daily Commute (km)</span>
          <span id="dailyKmVal" class="font-bold text-amber-400 text-base">100 km</span>
        </div>
        <input type="range" id="dailyKm" min="5" max="300" step="5" value="100" class="w-full accent-amber-500 h-2 bg-slate-800 rounded-lg cursor-pointer" oninput="calculate()">
      </div>

      <div>
        <div class="flex justify-between text-sm mb-1">
          <span class="text-slate-300 font-medium">Original Mileage (Pure / BS4/6 Petrol)</span>
          <span id="mileageVal" class="font-bold text-amber-400 text-base">40 km/l</span>
        </div>
        <input type="range" id="mileage" min="8" max="75" step="1" value="40" class="w-full accent-amber-500 h-2 bg-slate-800 rounded-lg cursor-pointer" oninput="calculate()">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Fuel Price (₹/Litre)</label>
          <input type="number" id="fuelPrice" value="100" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white font-medium focus:outline-none focus:border-amber-500" oninput="calculate()">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Efficiency Drop (%)</label>
          <input type="number" id="dropPercent" value="6" step="0.5" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white font-medium focus:outline-none focus:border-amber-500" oninput="calculate()">
          <span class="text-[10px] text-slate-500">Avg: 5% to 8%</span>
        </div>
      </div>

    </div>

    <div class="my-6 border-t border-slate-800"></div>

    <div class="bg-slate-950 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="text-center">
        <span class="text-xs uppercase font-bold tracking-widest text-slate-400">Your Annual "Hidden E20 Tax"</span>
        <div id="annualLoss" class="text-4xl font-extrabold text-red-500 mt-1">₹0</div>
        <p class="text-xs text-slate-500 mt-1">Direct money out of pocket due to lower energy density.</p>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-800/80 text-center">
        <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
          <div class="text-xs text-slate-400">Monthly Loss</div>
          <div id="monthlyLoss" class="text-lg font-bold text-slate-100 mt-0.5">₹0</div>
        </div>
        <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
          <div class="text-xs text-slate-400">Extra Fuel / Year</div>
          <div id="extraFuel" class="text-lg font-bold text-amber-400 mt-0.5">0 L</div>
        </div>
      </div>
    </div>

    <p class="text-[11px] text-slate-500 text-center mt-4 leading-relaxed">
      *Calculations assume standard petrol equivalent energy parity loss against 20% ethanol blend. Excludes potential injector/fuel line maintenance costs on pre-April 2023 vehicles.
    </p>

  </div>

  <script>
    function calculate() {
      const dailyKm = parseFloat(document.getElementById('dailyKm').value);
      const originalMileage = parseFloat(document.getElementById('mileage').value);
      const fuelPrice = parseFloat(document.getElementById('fuelPrice').value) || 0;
      const dropPercent = parseFloat(document.getElementById('dropPercent').value) || 0;

      // Update Labels
      document.getElementById('dailyKmVal').innerText = dailyKm + ' km';
      document.getElementById('mileageVal').innerText = originalMileage + ' km/l';

      // Math
      const e20Mileage = originalMileage * (1 - (dropPercent / 100));
      
      const litersOriginalDaily = dailyKm / originalMileage;
      const litersE20Daily = dailyKm / e20Mileage;

      const extraLitersDaily = litersE20Daily - litersOriginalDaily;
      const dailyLoss = extraLitersDaily * fuelPrice;

      const monthlyLoss = dailyLoss * 30;
      const annualLoss = dailyLoss * 365;
      const annualExtraLiters = extraLitersDaily * 365;

      // Render formatted output
      document.getElementById('annualLoss').innerText = '₹' + Math.round(annualLoss).toLocaleString('en-IN');
      document.getElementById('monthlyLoss').innerText = '₹' + Math.round(monthlyLoss).toLocaleString('en-IN');
      document.getElementById('extraFuel').innerText = Math.round(annualExtraLiters).toLocaleString('en-IN') + ' Litres';
    }

    function setPreset(km, price, mileage, drop) {
      document.getElementById('dailyKm').value = km;
      document.getElementById('fuelPrice').value = price;
      document.getElementById('mileage').value = mileage;
      document.getElementById('dropPercent').value = drop;
      calculate();
    }

    // Initial run
    calculate();
  </script>
</body>
</html>
